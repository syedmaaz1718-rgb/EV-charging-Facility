<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>EV ChargeNet</title><link rel="stylesheet" href="/css/app.css">
<style>.flash{padding:12px 16px;border-radius:10px;margin-bottom:16px;font-size:14px}
.flash.ok{background:#123a26;color:#4ade80;border:1px solid #22c55e55}
.flash.err{background:#3a1414;color:#f87171;border:1px solid #f8717155}
.actions form{display:inline}</style></head><body>
<div class="sidebar"><div class="logo">&#9889; EV<span>ChargeNet</span></div><div class="nav">
<c:choose><c:when test="${user.role()=='ADMIN'}">
<a class="${active=='dashboard'?'on':''}" href="/admin">&#9719; Dashboard</a>
<a class="${active=='stations'?'on':''}" href="/admin/stations">&#9889; Stations</a>
<a class="${active=='customers'?'on':''}" href="/admin/customers">&#9787; Customers</a>
<a class="${active=='reports'?'on':''}" href="/admin/reports">&#9644; Reports</a>
</c:when><c:otherwise>
<a class="${active=='dashboard'?'on':''}" href="/dashboard">&#9719; Dashboard</a>
<a class="${active=='history'?'on':''}" href="/history">&#9696; History</a>
</c:otherwise></c:choose>
<a href="/">&#8617; Home page</a>
<a href="/logout">&#10005; Sign out</a>
</div></div>
<div class="main">
<div class="top"><div><h1>${title}</h1><div class="sub">ABC Green Energy Solutions Pvt. Ltd.</div></div>
<div class="user"><b>&#9679;</b> ${user.name()} &middot; ${user.role()=='ADMIN'?'Admin':'Customer'}</div></div>
<c:if test="${not empty ok}"><div class="flash ok">${ok}</div></c:if>
<c:if test="${not empty error}"><div class="flash err">${error}</div></c:if>
